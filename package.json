{
  "name": "@local/dsh-fathomkernel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A self-evolving algorithm optimizer for DeepSeek Harness: declare a goal and its acceptance conditions, let real hardware measurement decide.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/*.js",
    "docs/architecture.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
